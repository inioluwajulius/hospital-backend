# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=

# Auth: long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: separate secret for hashing one-time codes (defaults to JWT_SECRET)
OTP_SECRET=

# Email via Brevo SMTP (Brevo dashboard > SMTP & API > SMTP tab)
# BREVO_SMTP_USER is the SMTP login shown there; BREVO_SMTP_PASSWORD is an SMTP key (not an API key).
# Port 587 upgrades to TLS with STARTTLS; use 465 for implicit TLS, or 2525 if 587 is blocked.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Must be a sender or domain verified in Brevo (Senders, Domains & Dedicated IPs)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MediCare

# While no SMTP host is set, emails are skipped (logged without content) and new
# accounts are not required to verify their email.
