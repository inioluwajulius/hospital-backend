# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=

# Auth: long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: separate secret for hashing one-time codes (defaults to JWT_SECRET)
OTP_SECRET=

# Email via Brevo. On hosts that block outbound SMTP (Render free tier blocks ports
# 25, 465 and 587), use the HTTP API: Brevo dashboard > SMTP & API > API Keys.
BREVO_API_KEY=

# Email via Brevo SMTP (fallback, e.g. local development; Brevo dashboard > SMTP & API > SMTP tab)
# BREVO_SMTP_USER is the SMTP login shown there; BREVO_SMTP_PASSWORD is an SMTP key (not an API key).
# Port 587 upgrades to TLS with STARTTLS; use 465 for implicit TLS, or 2525 if 587 is blocked.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Must be a sender or domain verified in Brevo (Senders, Domains & Dedicated IPs)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MediCare

# While no SMTP host is set, emails are skipped (logged without content) and new
# accounts are not required to verify their email.

# Reverse proxies in front of the app (used to find the real client IP for rate
# limiting). Default 1. On Render use 3 (verify: req.ip should equal your own IP).
TRUST_PROXY=1

# Video/voice calls use native WebRTC: audio and video go directly between the two
# browsers, and the app's own Socket.IO server carries the call setup. No calling
# platform, account or API key is needed.
# STUN (optional): defaults to Google's free public STUN servers, an external service
# that never sees audio/video. Use your own with a comma-separated list, or "none".
STUN_URLS=
# TURN (optional): only for networks that block direct calls; a relay you host
# yourself, e.g. coturn on a VPS. Comma-separated URLs.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
